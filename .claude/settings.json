{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$INPUT_FILE_PATH\" == *.py ]]; then cd /Users/teopopescu/Desktop/resonantia/backend && uv run ruff check \"$INPUT_FILE_PATH\" --fix 2>&1 | head -20; fi"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "resonantia": {
      "command": "uv",
      "args": ["run", "--directory", "/Users/teopopescu/Desktop/resonantia/backend", "python", "-m", "resonantia.mcp_server"],
      "env": {
        "RESONANTIA_ORG_ID": "org_default"
      }
    }
  }
}
